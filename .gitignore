# ChileRisk root .gitignore


# Environment files (never commit real secrets or local config)
.env
.env.local
.env.*.local

# Docker
docker-compose.override.yml

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# Python (cross-cutting + backend/)
# The detailed/complete Python ignores now live in backend/.gitignore.
# These patterns at root provide defense-in-depth (caches can appear from tools
# running at repo root or other Python experiments). Recursive ** not required;
# gitignore matches these names anywhere in the tree by default for these globs.
__pycache__/
*.py[cod]
*$py.class

# (Historical note: the previous "backend/*..." lines were single-level only and
#  completely omitted __pycache__/. They have been replaced by the combination
#  of this section + backend/.gitignore.)

# Node / Frontend
node_modules/
.next/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Other package manager lockfiles (monorepo standardization)
# Frontend is standardized on bun (see frontend/.gitignore + Dockerfile).
# These prevent accidental commits if someone runs npm/pnpm/yarn at root.
package-lock.json
pnpm-lock.yaml
yarn.lock

# Misc
*.bak
*.tmp

# Local scratch / IDE (AGENTS.md: misc/ off-limits)
misc/

# Build scratch (GDAL evacuacion pipeline, etc.)
.tmp/

# Raw evacuation shapefiles (~200MB+) — build with `make evacuacion-data`
frontend/data/evacuacion-source/**
!frontend/data/evacuacion-source/README.md

# caveman-compress backups
*.original.md

# Local OpenCode agent config
opencode.json


# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end