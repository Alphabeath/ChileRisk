# ChileRisk root .gitignore

# 
TrueRisk/

# Environment files (never commit real secrets or local config)
.env
.env.local
.env.*.local

# Docker
docker-compose.override.yml

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.log

# Python (backend only)
backend/*pyc
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg

# Node / Frontend
node_modules/
.next/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.bak
*.tmp
