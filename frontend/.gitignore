# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Package manager lockfiles (monorepo standardization)
# We use bun (bun.lock) as the single source of truth.
# See frontend/Dockerfile (bun install) and frontend/.dockerignore.
# npm / pnpm / yarn locks are intentionally not committed.
package-lock.json
pnpm-lock.yaml
yarn.lock

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
