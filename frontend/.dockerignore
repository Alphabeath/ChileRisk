# Frontend .dockerignore
# Prevents sending unnecessary files into the Docker build context

# Dependencies
node_modules

# Next.js build output
.next
out

# Testing
coverage
*.log

# Git
.git
.gitignore

# Misc
README.md
.env*
!.env.example
*.md

# Editor / OS
.idea
.vscode
*.swp
.DS_Store

# Lockfiles we don't need (we copy bun.lock in Dockerfile; bun is the standardized package manager)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Raw SHP source (~200MB) — only public/data/evacuacion runtime assets are needed in the image
data/evacuacion-source
