# ChileRisk - Docker Compose / Dokploy environment example
# Copia este archivo como `.env` (local) o pégalo en Environment de Dokploy.
# Nunca commits el `.env` real.
#
# Referencia canónica de variables: backend/.env.example + backend/app/config.py.
# Todas las variables ausentes de este archivo usan su default en config.py.

# ============================================
# Puertos en el host (solo local / acceso loopback)
# En Dokploy el tráfico público va por Traefik → frontend:3000
# ============================================
POSTGRES_HOST_PORT=5434
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ============================================
# PostgreSQL (compose inyecta DATABASE_URL al backend)
# En VPS/Dokploy: usa un password fuerte (no el default).
# Si cambias el password con volumen ya creado, hay que recrear el volumen o alterar el role.
# ============================================
POSTGRES_DB=chilerisk
POSTGRES_USER=chilerisk
POSTGRES_PASSWORD=chilerisk
# DATABASE_URL NO se define aquí: docker-compose.yml la genera desde POSTGRES_*
# (postgresql+asyncpg://<user>:<pass>@db:5432/<db>) y la inyecta al backend;
# una definición en .env quedaría sobreescrita por `environment:` del compose.
# Para dev nativo sin Docker usa backend/.env.example.

# ============================================
# Scheduler
# ============================================
ENABLE_SCHEDULER=true
RISK_REFRESH_MINUTES=15

# ============================================
# CSN (sismos) + Open-Meteo (clima) + GloFAS (inundaciones)
# ============================================
CSN_BASE_URL=https://www.sismologia.cl
CSN_RECENT_PATH=/
OPENMETEO_API_BASE=https://api.open-meteo.com/v1
FLOOD_REFRESH_MINUTES=360  # GloFAS actualiza diario; 6h es conservador

# ============================================
# SERNAPRED (alertas oficiales — AppSync GraphQL)
# Identity Pool / endpoint son públicos (mismo flujo que la web oficial), no secretos.
# ============================================
SENAPRED_REFRESH_MINUTES=10
SENAPRED_AWS_REGION=us-east-1
SENAPRED_COGNITO_IDENTITY_POOL_ID=us-east-1:17c696bc-53e1-49a2-991f-f1b65f752fda
SENAPRED_APPSYNC_ENDPOINT=https://rz2uv7ifxbgflh2bqmp6kmh4le.appsync-api.us-east-1.amazonaws.com/graphql
SENAPRED_ALERT_BASE_URL=https://senapred.cl/alerta/
SENAPRED_EVENT_BASE_URL=https://senapred.cl/evento/
SENAPRED_LOOKBACK_DAYS=30
SENAPRED_EVENTO_ACTIVE_HOURS=48

# ============================================
# Simulacros SERNAPRED (calendario público — scraping)
# ============================================
SIMULACROS_BASE_URL=https://senapred.cl/simulacros/
SIMULACROS_LOOKBACK_DAYS=365
SIMULACROS_LOOKFORWARD_DAYS=180
SIMULACROS_REFRESH_MINUTES=1440
SIMULACROS_REQUEST_TIMEOUT_SECONDS=30
SIMULACROS_MAX_RECENT_PAGES=5

# ============================================
# Aire Chile GEC (calidad del aire / episodios críticos — scraping)
# Cobertura parcial: zonas saturadas PPDA (~10).
# ============================================
AIRECHILE_BASE_URL=https://airechile.mma.gob.cl/
AIRECHILE_REFRESH_MINUTES=180
AIRECHILE_REQUEST_TIMEOUT_SECONDS=30

# ============================================
# SERNAGEOMIN (alertas volcánicas OVDAS — scraping)
# Solo alertas elevadas vigentes (≥ amarilla).
# ============================================
SERNAGEOMIN_ALERTS_URL=https://www.sernageomin.cl/alertas-volcanicas/
SERNAGEOMIN_REFRESH_MINUTES=60
SERNAGEOMIN_REQUEST_TIMEOUT_SECONDS=30
# El sitio suele servir cadena TLS incompleta; false para que el sync funcione.
SERNAGEOMIN_SSL_VERIFY=false

# ============================================
# Cache TTLs (segundos)
# ============================================
CACHE_TTL_SECONDS=300
CACHE_METEO_TTL_SECONDS=21600

# ============================================
# Autenticación (Auth.js + FastAPI JWT) — LOCAL
# ============================================
# PyJWT / Auth.js: mínimo 32 bytes. Genera uno: openssl rand -base64 48
AUTH_SECRET=dev-change-me-generate-a-long-secret
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@chilerisk.local

# ============================================
# Asistente ciudadano (DeepSeek tool-calling)
# La API key nunca se expone al frontend.
# ============================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOOL_ROUNDS=5
CHAT_HISTORY_ENABLED=true

# ============================================
# PRODUCCIÓN — chilerisk.cl (Dokploy)
# Descomenta / reemplaza al desplegar. AUTH_SECRET debe ser el mismo en FE+BE.
# ============================================
# AUTH_URL=https://chilerisk.cl
# BACKEND_CORS_ORIGINS=["https://chilerisk.cl","https://www.chilerisk.cl"]
# AUTH_EMAIL_FROM=noreply@chilerisk.cl
# POSTGRES_PASSWORD=<password-fuerte>
# AUTH_SECRET=<openssl rand -base64 48>
#
# DNS: A/AAAA de chilerisk.cl (y www) → IP del VPS
# Dokploy Domains: servicio frontend, puerto 3000, HTTPS
# Google OAuth (si aplica): https://chilerisk.cl/api/auth/callback/google
# No actives profile tools (Adminer)
