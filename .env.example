# ChileRisk - Docker Compose environment example
# Copia este archivo como `.env` y ajusta los valores según tu máquina.

# ============================================
# Puertos expuestos en tu host (Docker Compose)
# ============================================
POSTGRES_HOST_PORT=5434
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000

# ============================================
# Configuración del Backend (se carga en el contenedor)
# Estas variables controlan el modo híbrido (datos reales vs mock)
# ============================================

# Habilitar datos reales de sismos desde CSN (sismologia.cl)
USE_REAL_CSN=true

# Habilitar datos reales de clima desde Open-Meteo
USE_REAL_METEO=true

# Habilitar alertas oficiales desde SERNAPRED (senapred.cl/sismos-alertas)
USE_REAL_SENAPRED=true
SENAPRED_REFRESH_MINUTES=10
# Base URL para construir el link al artículo de cada alerta en senapred.cl
SENAPRED_ALERT_BASE_URL=https://senapred.cl/alerta/

# Scheduler y jobs en segundo plano
ENABLE_SCHEDULER=true
RISK_REFRESH_MINUTES=15

# TTLs de caché (en segundos)
CACHE_TTL_SECONDS=300
CACHE_METEO_TTL_SECONDS=21600

# ============================================
# Opcional: overrides de APIs externas
# ============================================
# CSN_BASE_URL=https://www.sismologia.cl
# CSN_RECENT_PATH=/
# OPENMETEO_API_BASE=https://api.open-meteo.com/v1

# ============================================
# Autenticación (Auth.js + FastAPI JWT)
# ============================================
AUTH_SECRET=dev-change-me-in-production
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@chilerisk.local

# Nota: DATABASE_URL y BACKEND_CORS_ORIGINS ya están
# configurados en docker-compose.yml para el entorno Docker.
# No es necesario definirlos aquí a menos que quieras sobreescribirlos.
