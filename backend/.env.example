# ChileRisk Backend Environment
DATABASE_URL=postgresql+asyncpg://chilerisk:chilerisk@localhost:5432/chilerisk
# For local dev without Docker you can use SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ENABLE_SCHEDULER=true
RISK_REFRESH_MINUTES=15   # Frequency (in minutes) of the main risk score recomputation job (works in both mock and hybrid modes)

# Hybrid data mode (toggle per source)
# When using Docker Compose, these are usually set in the root .env file (recommended)
USE_REAL_CSN=false
USE_REAL_METEO=false
CSN_BASE_URL=https://www.sismologia.cl
CSN_RECENT_PATH=/
OPENMETEO_API_BASE=https://api.open-meteo.com/v1

# Meteo update frequency (minutes) — default 60
# METEO_REFRESH_MINUTES=60

# Cache TTLs (seconds)
CACHE_TTL_SECONDS=300
CACHE_METEO_TTL_SECONDS=21600
