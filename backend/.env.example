# ChileRisk Backend Environment
# Este archivo es para desarrollo local (sin Docker).
# Para Docker Compose usa el .env de la raíz del proyecto.

# Base de datos (desarrollo local)
DATABASE_URL=postgresql+asyncpg://chilerisk:chilerisk@localhost:5432/chilerisk
# Para desarrollo sin Postgres puedes usar SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Local. Prod/Dokploy (chilerisk.cl): ["https://chilerisk.cl","https://www.chilerisk.cl"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Scheduler
ENABLE_SCHEDULER=true
RISK_REFRESH_MINUTES=15

# ============================================
# Real data sources are always used. If a provider is unavailable, no value is generated.
# ============================================
# Habilitar alertas oficiales desde SERNAPRED (senapred.cl/sismos-alertas)
SENAPRED_REFRESH_MINUTES=10
SENAPRED_AWS_REGION=us-east-1
# Identity Pool público (no es un secreto). Permite acceso anónimo a la API
# GraphQL pública de SERNAPRED (mismo flujo que la web oficial).
SENAPRED_COGNITO_IDENTITY_POOL_ID=us-east-1:17c696bc-53e1-49a2-991f-f1b65f752fda
SENAPRED_APPSYNC_ENDPOINT=https://rz2uv7ifxbgflh2bqmp6kmh4le.appsync-api.us-east-1.amazonaws.com/graphql
# Base URL usada para construir el link al artículo de cada alerta
# (concatena urlAccess → https://senapred.cl/alerta/<slug>)
SENAPRED_ALERT_BASE_URL=https://senapred.cl/alerta/
SENAPRED_EVENT_BASE_URL=https://senapred.cl/evento/
SENAPRED_LOOKBACK_DAYS=30
# Max age of kind=evento on today's active list (AppSync rarely clears isActive on sismos)
SENAPRED_EVENTO_ACTIVE_HOURS=48

# ============================================
# Simulacros SERNAPRED (calendario público)
# ============================================
# Scraping del calendario público de https://senapred.cl/simulacros/.
# Si senapred.cl no responde, el endpoint queda vacío hasta el próximo ciclo
# del scheduler.
SIMULACROS_BASE_URL=https://senapred.cl/simulacros/
SIMULACROS_LOOKBACK_DAYS=365
SIMULACROS_LOOKFORWARD_DAYS=180
SIMULACROS_REFRESH_MINUTES=1440
SIMULACROS_REQUEST_TIMEOUT_SECONDS=30
SIMULACROS_MAX_RECENT_PAGES=5

# ============================================
# Aire Chile GEC (calidad del aire / episodios críticos)
# ============================================
# Scraping de https://airechile.mma.gob.cl/ (HTML; sin API pública).
# Cobertura parcial: zonas saturadas PPDA (~10).
AIRECHILE_BASE_URL=https://airechile.mma.gob.cl/
AIRECHILE_REFRESH_MINUTES=180
AIRECHILE_REQUEST_TIMEOUT_SECONDS=30

# ============================================
# SERNAGEOMIN alertas volcánicas (OVDAS)
# ============================================
# Scraping de https://www.sernageomin.cl/alertas-volcanicas/ (HTML; sin API pública).
# Solo alertas elevadas vigentes (≥ amarilla).
SERNAGEOMIN_ALERTS_URL=https://www.sernageomin.cl/alertas-volcanicas/
SERNAGEOMIN_REFRESH_MINUTES=60
SERNAGEOMIN_REQUEST_TIMEOUT_SECONDS=30
# Incomplete cert chain on sernageomin.cl — set true only if your CA bundle validates it.
SERNAGEOMIN_SSL_VERIFY=false

# ============================================
# MeteoChile DMC AAA (Avisos / Alertas / Alarmas)
# ============================================
# JSON público: https://archivos.meteochile.gob.cl/portaldmc/AAA/datos_AAA.json
METEOCHILE_AAA_URL=https://archivos.meteochile.gob.cl/portaldmc/AAA/datos_AAA.json
METEOCHILE_REFRESH_MINUTES=15
METEOCHILE_REQUEST_TIMEOUT_SECONDS=30

# URLs de fuentes externas
CSN_BASE_URL=https://www.sismologia.cl
CSN_RECENT_PATH=/
OPENMETEO_API_BASE=https://api.open-meteo.com/v1

# Cache TTLs (segundos)
CACHE_TTL_SECONDS=300
CACHE_METEO_TTL_SECONDS=21600

# ============================================
# Autenticación (JWT compartido con Auth.js en frontend)
# ============================================
# ≥32 bytes (PyJWT). Prod/Dokploy: openssl rand -base64 48
AUTH_SECRET=dev-change-me-generate-a-long-secret
# Local. Prod: https://chilerisk.cl
AUTH_URL=http://localhost:3000
RESEND_API_KEY=
# Local. Prod: noreply@chilerisk.cl (dominio verificado en Resend)
AUTH_EMAIL_FROM=noreply@chilerisk.local

# ============================================
# Asistente ciudadano (DeepSeek tool-calling)
# ============================================
# Key from https://platform.deepseek.com — never expose to the frontend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOOL_ROUNDS=5
CHAT_HISTORY_ENABLED=true

# Nota:
# - Las fuentes externas se consultan siempre; si una falla, no se agregan datos sintéticos.
# - El job de clima corre cada 60 minutos cuando el scheduler está activo.
# - Para Docker Compose, edita el .env de la raíz (no este archivo).
