{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/kimi-k2.7-code",
      "description": "Planifica y delega implementación"
    },
    "implementer": {
      "mode": "subagent",
      "model": "opencode-go/minimax-m3",
      "description": "Implementa código según especificaciones exactas",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}
